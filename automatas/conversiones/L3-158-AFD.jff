<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--Creado con practica2-tc (src/formatos.py).-->
<structure>
	<!--alfabeto: ["0", "1"]-->
	<type>fa</type>
	<automaton>
		<state id="0" name="{q1}">
			<x>80.0</x>
			<y>80.0</y>
			<initial/>
		</state>
		<state id="1" name="{q2}">
			<x>240.0</x>
			<y>105.0</y>
		</state>
		<state id="2" name="{q3}">
			<x>400.0</x>
			<y>80.0</y>
			<final/>
		</state>
		<transition><from>0</from><to>1</to><read>0</read></transition>
		<transition><from>1</from><to>2</to><read>1</read></transition>
	</automaton>
</structure>
