<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--Creado con practica2-tc (src/formatos.py).-->
<structure>
	<!--alfabeto: ["0", "1", "2"]-->
	<type>fa</type>
	<automaton>
		<state id="0" name="{q0}">
			<x>80.0</x>
			<y>135.0</y>
			<initial/>
		</state>
		<state id="1" name="{q1}">
			<x>560.0</x>
			<y>160.0</y>
			<final/>
		</state>
		<state id="2" name="{q2, q4, q5}">
			<x>240.0</x>
			<y>105.0</y>
		</state>
		<state id="3" name="{q3, q6}">
			<x>400.0</x>
			<y>80.0</y>
		</state>
		<state id="4" name="{q4, q5}">
			<x>240.0</x>
			<y>215.0</y>
		</state>
		<state id="5" name="{q6}">
			<x>400.0</x>
			<y>190.0</y>
		</state>
		<transition><from>0</from><to>2</to><read>0</read></transition>
		<transition><from>0</from><to>4</to><read>1</read></transition>
		<transition><from>0</from><to>4</to><read>2</read></transition>
		<transition><from>1</from><to>2</to><read>0</read></transition>
		<transition><from>1</from><to>4</to><read>1</read></transition>
		<transition><from>1</from><to>4</to><read>2</read></transition>
		<transition><from>2</from><to>3</to><read>0</read></transition>
		<transition><from>2</from><to>3</to><read>1</read></transition>
		<transition><from>2</from><to>3</to><read>2</read></transition>
		<transition><from>3</from><to>1</to><read>0</read></transition>
		<transition><from>3</from><to>1</to><read>1</read></transition>
		<transition><from>3</from><to>1</to><read>2</read></transition>
		<transition><from>4</from><to>3</to><read>0</read></transition>
		<transition><from>4</from><to>5</to><read>1</read></transition>
		<transition><from>4</from><to>5</to><read>2</read></transition>
		<transition><from>5</from><to>1</to><read>0</read></transition>
	</automaton>
</structure>
