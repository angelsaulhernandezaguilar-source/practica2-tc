<structure>
	<!--alfabeto: ["0", "1"]-->
	<type>fa</type>
	<automaton>
		<state id="0" name="{q0}">
			<x>80.0</x>
			<y>135.0</y>
			<initial/>
		</state>
		<state id="1" name="{q10, q11, q12, q13, q14, q15, q16, q5, q6, q8, q9}">
			<x>240.0</x>
			<y>105.0</y>
			<final/>
		</state>
		<state id="2" name="{q12, q15, q16, q17, q7}">
			<x>240.0</x>
			<y>215.0</y>
			<final/>
		</state>
		<state id="3" name="{q16, q17}">
			<x>400.0</x>
			<y>135.0</y>
			<final/>
		</state>
		<transition><from>0</from><to>2</to><read>0</read></transition>
		<transition><from>0</from><to>1</to><read>1</read></transition>
		<transition><from>1</from><to>3</to><read>0</read></transition>
		<transition><from>1</from><to>1</to><read>1</read></transition>
		<transition><from>2</from><to>3</to><read>0</read></transition>
	</automaton>
</structure>
