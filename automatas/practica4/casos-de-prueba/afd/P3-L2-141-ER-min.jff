<!--Creado con practica2-tc (src/formatos.py).-->
<structure>
	<!--alfabeto: ["0", "1"]-->
	<type>fa</type>
	<automaton>
		<state id="0" name="[{q8}, {q0, q1, q2, q6, q7, q9}, {q0, q2, q5, q6, q7, q9}]">
			<x>80.0</x>
			<y>80.0</y>
			<initial/>
			<final/>
		</state>
		<state id="1" name="{q3, q4}">
			<x>240.0</x>
			<y>105.0</y>
		</state>
		<state id="2" name="∅">
			<x>400.0</x>
			<y>80.0</y>
		</state>
		<transition><from>0</from><to>1</to><read>0</read></transition>
		<transition><from>0</from><to>0</to><read>1</read></transition>
		<transition><from>1</from><to>2</to><read>0</read></transition>
		<transition><from>1</from><to>0</to><read>1</read></transition>
		<transition><from>2</from><to>2</to><read>0</read></transition>
		<transition><from>2</from><to>2</to><read>1</read></transition>
	</automaton>
</structure>
