<structure>
	<!--alfabeto: ["0", "1"]-->
	<type>fa</type>
	<automaton>
		<state id="0" name="[{q12}, {q0, q2, q4, q11, q13}]">
			<x>80.0</x>
			<y>80.0</y>
			<initial/>
			<final/>
		</state>
		<state id="1" name="[{q1, q5, q6, q8, q9, q10}, {q3, q5, q6, q8, q9, q10}, {q6, q7, q9, q10}]">
			<x>240.0</x>
			<y>105.0</y>
		</state>
		<transition><from>0</from><to>1</to><read>0</read></transition>
		<transition><from>0</from><to>1</to><read>1</read></transition>
		<transition><from>1</from><to>0</to><read>0</read></transition>
		<transition><from>1</from><to>1</to><read>1</read></transition>
	</automaton>
</structure>
