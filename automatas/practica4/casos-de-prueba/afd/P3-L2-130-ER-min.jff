<structure>
	<!--alfabeto: ["0", "1"]-->
	<type>fa</type>
	<automaton>
		<state id="0" name="[{q2}, {q0, q1, q3, q4}]">
			<x>80.0</x>
			<y>80.0</y>
			<initial/>
		</state>
		<state id="1" name="[{q5, q6, q8, q16, q18, q19}, {q6, q7, q8, q16, q17, q19}, {q6, q8, q11, q15, q16, q17, q19}, {q6, q8, q13, q15, q16, q17, q19}]">
			<x>240.0</x>
			<y>105.0</y>
			<final/>
		</state>
		<state id="2" name="{q9, q10, q12, q14}">
			<x>400.0</x>
			<y>80.0</y>
		</state>
		<transition><from>0</from><to>0</to><read>0</read></transition>
		<transition><from>0</from><to>1</to><read>1</read></transition>
		<transition><from>1</from><to>2</to><read>0</read></transition>
		<transition><from>1</from><to>1</to><read>1</read></transition>
		<transition><from>2</from><to>1</to><read>0</read></transition>
		<transition><from>2</from><to>1</to><read>1</read></transition>
	</automaton>
</structure>
