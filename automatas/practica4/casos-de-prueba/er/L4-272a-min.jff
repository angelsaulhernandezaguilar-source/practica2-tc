<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--Creado con practica2-tc (src/formatos.py).-->
<structure>
	<!--alfabeto: ["a", "b"]-->
	<type>fa</type>
	<automaton>
		<state id="0" name="{q6}">
			<x>80.0</x>
			<y>135.0</y>
			<initial/>
			<final/>
		</state>
		<state id="1" name="{q1, q7}">
			<x>240.0</x>
			<y>105.0</y>
			<final/>
		</state>
		<state id="2" name="{q2, q3, q5, q7}">
			<x>240.0</x>
			<y>215.0</y>
			<final/>
		</state>
		<state id="3" name="∅">
			<x>400.0</x>
			<y>135.0</y>
		</state>
		<transition><from>0</from><to>1</to><read>a</read></transition>
		<transition><from>0</from><to>2</to><read>b</read></transition>
		<transition><from>1</from><to>3</to><read>a</read></transition>
		<transition><from>1</from><to>3</to><read>b</read></transition>
		<transition><from>2</from><to>3</to><read>a</read></transition>
		<transition><from>2</from><to>2</to><read>b</read></transition>
		<transition><from>3</from><to>3</to><read>a</read></transition>
		<transition><from>3</from><to>3</to><read>b</read></transition>
	</automaton>
</structure>
