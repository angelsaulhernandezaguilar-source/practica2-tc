<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--Creado con practica2-tc (src/formatos.py).-->
<structure>
	<!--alfabeto: ["a", "b"]-->
	<type>fa</type>
	<automaton>
		<state id="0" name="{q10}">
			<x>80.0</x>
			<y>135.0</y>
			<initial/>
		</state>
		<state id="1" name="[{q1, q2, q6, q7, q11}, {q2, q5, q7, q11}]">
			<x>240.0</x>
			<y>105.0</y>
			<final/>
		</state>
		<state id="2" name="{q9, q11}">
			<x>240.0</x>
			<y>215.0</y>
			<final/>
		</state>
		<state id="3" name="∅">
			<x>400.0</x>
			<y>80.0</y>
		</state>
		<state id="4" name="{q3, q4}">
			<x>400.0</x>
			<y>190.0</y>
		</state>
		<transition><from>0</from><to>1</to><read>a</read></transition>
		<transition><from>0</from><to>2</to><read>b</read></transition>
		<transition><from>1</from><to>3</to><read>a</read></transition>
		<transition><from>1</from><to>4</to><read>b</read></transition>
		<transition><from>2</from><to>3</to><read>a</read></transition>
		<transition><from>2</from><to>3</to><read>b</read></transition>
		<transition><from>3</from><to>3</to><read>a</read></transition>
		<transition><from>3</from><to>3</to><read>b</read></transition>
		<transition><from>4</from><to>1</to><read>a</read></transition>
		<transition><from>4</from><to>3</to><read>b</read></transition>
	</automaton>
</structure>
