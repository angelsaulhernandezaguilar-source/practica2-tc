<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--Created for Tarea 2 - Teoria de la Computacion-->
<structure>
	<type>fa</type>
	<automaton>
		<!--The list of states.-->
		<state id="0" name="q0">
			<x>300.0</x>
			<y>300.0</y>
			<initial/>
			<final/>
		</state>
		<!--The list of transitions.-->
		<transition>
			<from>0</from>
			<to>0</to>
			<read>a</read>
		</transition>
		<transition>
			<from>0</from>
			<to>0</to>
			<read>b</read>
		</transition>
	</automaton>
</structure>